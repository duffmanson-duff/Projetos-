<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Abridor" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#E0A640</item>
        <item name="colorPrimaryDark">#12130F</item>
        <item name="colorAccent">#E0A640</item>
        <item name="android:windowBackground">#12130F</item>
